{
  "name": "长坡 · 私人投资工作台",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "长坡 · 仅本人访问",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postStartCommand": "python3 scripts/start_preview.py",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
